<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="学生通" Width="1280" Height="880" MinWidth="1000" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#F3F5FA" FontFamily="Microsoft YaHei UI" FontSize="14" Foreground="#243149">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="#316DE6"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="17,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,9"/><Setter Property="BorderBrush" Value="#D8DFEB"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="White"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Padding" Value="10,9"/><Setter Property="BorderBrush" Value="#D8DFEB"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style TargetType="ProgressBar"><Setter Property="Height" Value="7"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#407BEC"/><Setter Property="Background" Value="#E9EEF7"/></Style>
 </Window.Resources>
 <Grid Background="#F3F5FA"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#1D273B"><Grid Margin="22,30,16,20"><Grid.RowDefinitions><RowDefinition Height="135"/><RowDefinition Height="*"/><RowDefinition Height="100"/></Grid.RowDefinitions>
   <StackPanel><Image x:Name="BrandImage" Width="56" Height="56" HorizontalAlignment="Left"/><TextBlock Text="学生通" Foreground="White" Margin="0,8,0,0" FontSize="17"/><TextBlock Text="本机学习工作台" Foreground="#9CAAC4" FontSize="12" Margin="0,5,0,0"/></StackPanel>
   <StackPanel Grid.Row="1"><TextBlock Text="学习任务" Foreground="#8593AE" Margin="10,20,0,12" FontSize="11"/>
    <Button x:Name="NavChapters" Content="▤    章节" Margin="0,0,0,9" HorizontalContentAlignment="Left"/>
    <Button x:Name="NavHomework" Content="▧    作业" Margin="0,0,0,9" Background="#27344B"/>
    <Button x:Name="NavExams" Content="▣    考试" Margin="0,0,0,9" Background="#27344B"/>
    <Button x:Name="NavSignin" Content="◉    签到" Margin="0,0,0,9" Background="#27344B"/>
    <Button x:Name="NavReview" Content="▥    复习" Margin="0,0,0,9" Background="#27344B"/>
    <TextBlock Text="工具与偏好" Foreground="#8593AE" Margin="10,30,0,12" FontSize="11"/>
    <Button x:Name="NavSettings" Content="⚙    设置" Margin="0,0,0,9" Background="#27344B"/>
   </StackPanel>
   <StackPanel Grid.Row="2" VerticalAlignment="Bottom"><TextBlock x:Name="ServiceIndicator" Text="●  正在连接服务" Foreground="#A9BBD8" FontSize="12"/><TextBlock Text="桌面版 0.3.1 · 网页优先识别" Foreground="#7E8DA9" FontSize="11" Margin="0,8,0,0"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Column="1" Margin="34,27,34,18"><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="83"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
   <Grid Grid.Row="0"><StackPanel Orientation="Horizontal" VerticalAlignment="Top"><Button x:Name="PlatformChaoxing" Content="学习通" Padding="18,8" Margin="0,0,8,0"/><Button x:Name="PlatformRain" Content="雨课堂" Padding="18,8" Background="#E7EDFA" Foreground="#47658D"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock x:Name="CurrentAccount" Text="读取账号中…" VerticalAlignment="Center" Foreground="#78869B" Margin="0,0,12,0"/><Button x:Name="SwitchAccount" Content="切换账号" Padding="16,8" Background="White" Foreground="#47658D"/></StackPanel></Grid>
   <Grid Grid.Row="1"><StackPanel><TextBlock x:Name="PageTitle" Text="章节" FontSize="28" FontWeight="Bold"/><TextBlock x:Name="PageSubtitle" Text="课程、视频与章节小测，一处查看和管理。" Foreground="#7B879C" Margin="0,8,0,0"/></StackPanel><Button x:Name="RefreshButton" Content="刷新" Background="White" Foreground="#466185" HorizontalAlignment="Right" VerticalAlignment="Top"/></Grid>
   <Border Grid.Row="2" x:Name="NoticeBorder" Background="#E7EFFD" CornerRadius="7" Padding="14,10" Margin="0,0,0,16"><TextBlock x:Name="Notice" Text="正在连接本机学习服务…" Foreground="#3E6599" TextWrapping="Wrap"/></Border>
   <ScrollViewer x:Name="PageScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="PageContent" Margin="0,0,12,0"/></ScrollViewer>
   <TextBlock Grid.Row="4" x:Name="Footer" Text="本机运行 · 数据保存在当前安装目录" Foreground="#8792A5" FontSize="11" VerticalAlignment="Bottom"/>
  </Grid>
 </Grid>
</Window>
